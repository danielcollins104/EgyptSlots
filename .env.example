# ---- Server (never prefix with VITE_; these must not reach the browser bundle) ----
NODE_ENV=production
PORT=3001
DC_DB_PATH=/var/lib/casino/casino.db
# REQUIRED in production: 32+ random bytes, e.g. `openssl rand -hex 32`. Signs the ledger + audit hash chains.
DC_LEDGER_SECRET=
# Comma-separated browser origins allowed to call the API (e.g. https://oopsiwon.com)
DC_CORS_ORIGINS=
DC_TRUST_PROXY=false

# ---- Compliance (counsel must confirm) ----
DC_BLOCKED_STATES=MN,WA,ID,MI,NV,MT,CT,NY,NJ,DE,LA,CA,MD,WV
DC_MIN_AGE=18
# Real-prize SC spins stay OFF until the certified RTP is verified and disclosed
DC_SC_PLAY_ENABLED=false

# ---- Payment providers (all OFF by default). Enable only with provider approval for this business model ----
DC_PAYMENT_PROVIDERS=
SQUARE_ENVIRONMENT=sandbox
SQUARE_ACCESS_TOKEN=
SQUARE_APPLICATION_ID=
SQUARE_LOCATION_ID=
SQUARE_WEBHOOK_SIGNATURE_KEY=
SQUARE_WEBHOOK_URL=https://YOUR_DOMAIN/api/payments/webhook/square

# ---- Self-hosted stablecoin gateway (receive-only; NO private keys here) ----
DC_CRYPTO_NETWORKS=
DC_CRYPTO_TREASURY_ADDRESS=
DC_RPC_BASE=
DC_RPC_POLYGON=
DC_RPC_ETHEREUM=

# ---- Redemption policy ----
DC_REDEMPTION_METHODS=crypto
DC_REDEEM_MIN_SC_CENTS=5000
DC_REDEEM_MAX_SC_CENTS=250000
DC_REDEEM_DAILY_SC_CENTS=250000
DC_DUAL_CONTROL_SC_CENTS=50000
DC_DESTINATION_COOLING_HOURS=24
